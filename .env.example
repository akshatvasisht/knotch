# ── Knotch — environment template ──────────────────────────────────────────────
# Copy to .env and fill in the values you need.
#
# The offline demo needs NONE of these — run it with:
#   pip install -e ".[dashboard]"
#   bash scripts/demo_local.sh
# or equivalently:
#   KNOTCH_LLM=fake python -m engine --domain _template --all-scenarios --dashboard


# ── Backend selectors ──────────────────────────────────────────────────────────
# Defaults (env unset): STT/TTS/transport/bus = fake, LLM = nemotron.
# For a fully offline run, set KNOTCH_LLM=fake; all others already default to fake.
KNOTCH_LLM=nemotron      # fake (offline, no endpoint) | nemotron (any OpenAI-compatible endpoint)
KNOTCH_BUS=memory        # memory (single-process) | redis (multi-host distributed)
KNOTCH_STT=fake          # fake | nvidia (Nemotron ASR WebSocket)
KNOTCH_TTS=fake          # fake (prints to terminal) | gradium
KNOTCH_TRANSPORT=fake    # fake | daily (WebRTC browser transport)
KNOTCH_TURN=simple       # simple | smartturn (Smart Turn v3)


# ── LLM — routing brain ───────────────────────────────────────────────────────
# Any OpenAI-compatible vLLM endpoint works (llama.cpp, Ollama, Together, etc.).
# NOTE: the hackathon's hosted Nemotron endpoints are no longer active.
#       Supply your own endpoint + model; no NIM account needed for open alternatives.
KNOTCH_LLM_URL=<your-openai-compatible-llm-url>    # e.g. http://localhost:8000/v1
KNOTCH_LLM_MODEL=<your-model-name>                 # e.g. meta-llama/Llama-3.1-8B-Instruct
KNOTCH_LLM_THINKING=false                          # NIM-only extended thinking; keep false for low-latency voice


# ── STT — speech recognition ──────────────────────────────────────────────────
# Only needed when KNOTCH_STT=nvidia.
NVIDIA_ASR_URL=<your-nemotron-asr-websocket-url>    # e.g. ws://your-host:8080


# ── TTS — dispatcher voice ────────────────────────────────────────────────────
# Only needed when KNOTCH_TTS=gradium.
GRADIUM_API_KEY=<your-gradium-api-key>
GRADIUM_VOICE_ID=<your-gradium-voice-id>


# ── Distributed bus — Redis ───────────────────────────────────────────────────
# Only needed when KNOTCH_BUS=redis.
REDIS_URL=redis://localhost:6379


# ── WebRTC transport — Daily ──────────────────────────────────────────────────
# Only needed when running the participant workers in .starter/server/.
DAILY_API_KEY=<your-daily-api-key>


# ── Telephony — Twilio ────────────────────────────────────────────────────────
# Only needed for the full distributed stack (scripts/run_stack.sh).
TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_PHONE_NUMBER=<your-twilio-phone-number>       # e.g. +15551234567
TWILIO_PHONE_SID=<your-twilio-phone-number-sid>      # e.g. PNxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── Eval / self-improvement — Cekura ──────────────────────────────────────────
# Only needed for `proc_improve --cekura` (real LLM judge scoring).
# CEKURA_API_KEY=<your-cekura-api-key>
# CEKURA_BASE_URL=https://api.cekura.ai
# CEKURA_PROJECT_ID=<your-project-id>
# CEKURA_AGENT_ID=<your-agent-id>
